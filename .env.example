# Copiá este archivo a ".env" para desarrollo local. En Railway, estas
# mismas variables se cargan desde el panel "Variables" del servicio (ver
# README.md) — no hace falta ningún archivo .env ahí.

# La agrega sola Railway al conectar el plugin de Postgres al servicio.
DATABASE_URL="postgresql://usuario:password@localhost:5432/rm_selection"

# API key de Anthropic — la misma que usabas en la app, pero ahora vive
# acá en el servidor en vez de en el Keychain de cada dispositivo.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Clave privada inventada por vos (cualquier string largo al azar) que la
# app de iOS va a mandar en el header "x-api-key" para poder consultar la
# API. Sin esto configurado, la API queda abierta sin autenticación.
APP_API_KEY=""

# Horas de anticipación con las que se genera el Ranking del Día antes
# del inicio de cada jornada.
RANKING_LEAD_HOURS=12

# Cuántos Hips entran en el Ranking del Día (top N por puntaje).
TOP_RANKING_SIZE=20

PORT=8080

# Almacenamiento de objetos (Cloudflare R2) para fotos/videos y reportes
# veterinarios cargados desde la app — sincronización multidispositivo.
# Sin estas 4 variables, /me/media devuelve 503 (el resto de la API sigue
# funcionando igual). Se crean en el dashboard de Cloudflare: R2 > Create
# bucket, y R2 > Manage API Tokens > Create API Token (permiso Object
# Read & Write, scopeado a ese bucket).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Opcional: dominio público del bucket (custom domain, o el *.r2.dev que
# da Cloudflare al activar "Public Access") para leer objetos sin firmar
# URL. Sin esto, la lectura también usa una presigned URL (funciona igual,
# solo un poco más lenta).
R2_PUBLIC_BASE_URL=""
