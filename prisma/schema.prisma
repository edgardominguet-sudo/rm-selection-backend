// Esquema de base de datos del backend de RM Selection.
//
// Idea general: el backend es la única fuente de verdad del Ranking del
// Día. Descarga catálogos, resuelve automáticamente qué Hip corresponde a
// qué jornada, dispara el análisis con IA 12 horas antes de cada sesión, y
// guarda tanto el resultado de cada Hip como el ranking ya armado — la app
// de iOS solo lee esta base a través de la API, nunca vuelve a correr IA
// por su cuenta.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SaleHouse {
  FASIG_TIPTON
  KEENELAND
  OBS
}

enum UserRole {
  OWNER
  ADMIN
  BUYER
}

enum ObservationCategory {
  CONFORMATION
  MOVEMENT
  PEDIGREE
  GENERAL
}

// Un "equipo de trabajo" o comprador independiente. Hoy existe una sola
// Organization (tu equipo, todos viendo el mismo análisis) — pero el día
// que RM Selection sume compradores que no deben ver las decisiones,
// observaciones ni puntajes de otros (porque cada uno puede tener su
// propio caballo referente y por lo tanto sus propios resultados sobre el
// mismo Hip), no hace falta ninguna migración estructural: alcanza con dar
// de alta una Organization nueva. Todo lo que es "catálogo puro" (Sale,
// Hip) queda A PROPÓSITO fuera de esta tabla — ver comentario en Hip.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                   User[]
  analysisResults         AnalysisResult[]
  currentHipAnalyses      CurrentHipAnalysis[]
  rankingSnapshots        RankingSnapshot[]
  rankingSnapshotVersions RankingSnapshotVersion[]
  referenceHorses         ReferenceHorse[]
  decisions               UserDecision[]
  observations            HipObservation[]
}

// Un usuario de RM Selection. Hoy hay uno solo (vos), pero se modela desde
// ahora — sin esto, "sincronizar entre dispositivos" y "cuentas futuras" no
// tienen dónde anclarse, y agregarlo más adelante significaría migrar datos
// reales en vez de partir de una base limpia.
model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email       String?  @unique
  // Reemplaza a la clave compartida suelta (APP_API_KEY): la misma clave
  // ahora identifica a un usuario concreto, así cada decisión/observación
  // que se guarda queda asociada a alguien desde el primer día, sin tener
  // que construir login todavía. Login real (email/contraseña, magic link)
  // se agrega el día que haga falta una segunda persona con cuenta propia.
  apiKey      String?  @unique
  displayName String?
  role        UserRole @default(OWNER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  devices     Device[]
  decisions   UserDecision[]
  observations HipObservation[]
  catalogImports CatalogImport[]
}

// Un dispositivo (iPhone/iPad) desde el que un usuario usa la app. Deja
// lista la base para notificaciones push futuras ("se actualizó el
// ranking") y para saber desde qué dispositivo se tomó cada decisión —
// capturar esto desde el día uno es gratis; reconstruirlo después de que ya
// existan decisiones/observaciones sin esa procedencia no lo es.
model Device {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform    String    // "ios" (hoy); deja lugar a otras plataformas a futuro.
  deviceName  String?   // ej. "iPad de Ramon"
  appVersion  String?
  // Token de notificaciones push (APNs) — nil hasta que se construya esa
  // integración; la columna ya queda lista para no migrar de nuevo después.
  pushToken   String?
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())

  decisions   UserDecision[]
  observations HipObservation[]
}

// Qué tan utilizable es el catálogo estructurado de una venta:
// - FULL: hay una API de catálogo que se puede consultar directo (Keeneland
//   siempre; Fasig-Tipton cuando se conoce el ID numérico interno). El
//   scheduler la sincroniza sola (syncCatalog) y analiza normalmente.
// - MANUAL_CSV: la casa de ventas NO tiene ninguna API pública de catálogo
//   (hoy, OBS — se investigó a fondo el 2026-08-05: su catálogo real vive en
//   obscatalog.com, pero se renderiza 100% del lado del cliente vía
//   JavaScript/AJAX, sin ningún endpoint JSON/XML público identificable; no
//   hay Content-Type de datos en el HTML servidor, solo una tabla vacía que
//   se llena después. No hay forma automática y respetuosa de leerlo hoy).
//   En vez de quedar en un callejón sin salida permanente, el catálogo se
//   carga vía POST /sales/:saleId/catalog/import con un CSV/export (el mismo
//   formato que ya usan estas casas de venta para consignatarios/compradores
//   — ver saleHouses/manualCatalogImport.ts) — a partir de ahí, el Hip
//   generado pasa por EXACTAMENTE el mismo camino que un Hip de Keeneland o
//   Fasig-Tipton: análisis con IA, Ranking del Día, Historial de Ventas,
//   detección de media nueva en el próximo import. Solo el paso de "traer el
//   catálogo" es manual — todo lo de ahí en adelante sigue siendo automático.
// - PENDING_ID: se detectó el anuncio público (nombre, fechas) pero falta
//   resolver el ID interno que pide la API de catálogo — hoy pasa con
//   Fasig-Tipton, cuyo ID numérico no aparece en ninguna página pública,
//   solo se puede obtener inspeccionando la app oficial/portal del
//   comprador. Se investigó de nuevo el 2026-08-05: el parámetro
//   `sale_start_date` que sí acepta `django/api/filtered_pedigree_pdf/`
//   (visible en URLs indexadas por buscadores) NO funciona en
//   `django/api/horses/` (devuelve vacío); `django/api/sales/` existe (200,
//   no 404) pero devuelve `{}` con cualquier filtro probado — no hay bypass
//   público conocido. No se adivina el ID por fuerza bruta (violaría el
//   acceso autorizado) — queda visible en /api/v1/alerts hasta que alguien
//   cargue el ID real vía POST /sales. MANUAL_CSV queda disponible como
//   alternativa si alguien quiere estos Hips analizados ANTES de conseguir
//   el ID real (ver comentario arriba) — completar el ID real más adelante
//   simplemente pasa la venta a FULL sin perder nada de lo ya importado.
// - UNAVAILABLE: reservado para una casa de ventas sin NINGÚN camino de
//   acceso, ni siquiera manual (ej. ni catálogo público ni export
//   descargable en ningún formato) — hoy ninguna casa soportada cae en este
//   caso; ver saleHouses/discovery/obsDiscovery.ts.
enum SaleCatalogAccess {
  FULL
  MANUAL_CSV
  PENDING_ID
  UNAVAILABLE
}

// Una venta concreta (ej. "Fasig-Tipton — Saratoga 2026"). Hasta ahora se
// daba de alta a mano; ahora también puede crearla sola el descubrimiento
// automático (ver saleDiscoveryService.ts) apenas la casa de ventas la
// anuncia públicamente — a partir de ahí, todo lo demás (catálogo,
// sesiones, Hips, ranking) se resuelve solo, igual que antes.
//
// Sale y Hip quedan GLOBALES — sin organizationId — a propósito: son datos
// de catálogo público (nombre, consignatario, fotos tal como las publica
// la casa de ventas), iguales para cualquier organización que los mire. Si
// se scopearan por organización, cada organización nueva dispararía un
// scraping duplicado del mismo catálogo público. Lo que SÍ varía por
// organización es la EVALUACIÓN de ese catálogo (AnalysisResult y todo lo
// derivado) — ver comentario en AnalysisResult.
model Sale {
  id                 String     @id @default(cuid())
  house              SaleHouse
  name               String
  // ID interno que usa la API de catálogo de la casa de ventas. Para
  // ventas con catalogAccess distinto de FULL, esto es un identificador
  // SINTÉTICO (derivado del slug del anuncio público, no un ID real de
  // catálogo) — solo sirve para no duplicar la fila en @@unique([house,
  // externalSaleId]) hasta que se resuelva el ID de verdad.
  externalSaleId     String
  // Fecha real de la jornada (o del primer día, si la venta dura varios)
  // tal como la publica la casa de ventas. Se completa apenas se detecta
  // el anuncio (con la fecha que trae el anuncio público) y se refina
  // sola más precisa una vez que el catálogo trae Hips con sessionDate
  // resuelto (ver syncCatalog en rankingService.ts) — así el orden
  // cronológico entre casas queda bien desde el día uno, sin depender de
  // que el catálogo ya esté disponible. Null solo si todavía no se pudo
  // leer ninguna fecha confiable (no se inventa).
  startDate          DateTime?
  // Solo Keeneland: año + slug de la venta en la URL pública del
  // "Schedule of Sale", para poder resolver fecha de sesión por Hip sin
  // que el usuario cargue nada a mano (ver saleHouses/keenelandSchedule.ts).
  scheduleYear       Int?
  scheduleSlug       String?
  isActive           Boolean    @default(true)
  // Último momento en que se volvió a consultar el catálogo completo de
  // esta venta contra la casa de ventas. El scheduler decide CUÁNDO toca
  // volver a chequear según qué tan cerca esté la próxima jornada (ver
  // scheduler.ts / pollingPolicy.ts) — no chequea a un intervalo fijo
  // siempre, para no golpear la API de la casa de ventas más de lo
  // necesario cuando falta mucho, y chequear mucho más seguido cuando la
  // subasta está por arrancar o en curso.
  lastCatalogCheckAt DateTime?
  // null = dada de alta a mano (POST /sales, como hasta ahora). No-null =
  // la creó sola el descubrimiento automático, y este es el momento en que
  // se detectó el anuncio público por primera vez.
  discoveredAt       DateTime?
  // Link a la página/anuncio público donde se detectó — para poder
  // verificarla a simple vista desde /api/v1/alerts o el panel.
  announcementUrl    String?
  catalogAccess      SaleCatalogAccess @default(FULL)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  hips                    Hip[]
  rankingSnapshots        RankingSnapshot[]
  rankingSnapshotVersions RankingSnapshotVersion[]
  alerts                  SaleAlert[]
  catalogImports          CatalogImport[]

  @@unique([house, externalSaleId])
}

// Auditoría de cada carga manual de catálogo (ver SaleCatalogAccess.MANUAL_CSV
// y saleHouses/manualCatalogImport.ts) — deja registro de cuándo se cargó,
// quién lo cargó, cuántas filas trajo el archivo y cuántos Hips efectivamente
// se crearon/actualizaron, más cualquier advertencia de filas descartadas
// (ej. sin "Hip Number", fecha de sesión no parseable). Nunca se borra: es
// el equivalente de SchedulerRun para el camino manual, útil para responder
// "¿de dónde salió este dato?" o diagnosticar un import que trajo menos Hips
// de los esperados.
model CatalogImport {
  id             String   @id @default(cuid())
  saleId         String
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  importedByUserId String?
  importedByUser User?    @relation(fields: [importedByUserId], references: [id], onDelete: SetNull)

  fileName       String?
  rowCount       Int
  hipsCreated    Int
  hipsUpdated    Int
  // Filas descartadas o advertencias no fatales (ej. "fila 14: sin Hip
  // Number, se descarta", "fila 30: Session Date no parseable, se usó la
  // fecha de la venta"). Nunca detiene el import completo — una fila mala no
  // debe tirar abajo las 200 buenas.
  warningsJson   Json     @default("[]")

  createdAt      DateTime @default(now())

  @@index([saleId, createdAt])
}

// Registro de "novedades" — lo que la app le muestra al usuario cuando el
// descubrimiento automático encuentra una venta nueva o empieza a
// sincronizarla. Global (no por organización), igual que Sale: el hecho de
// que una casa de ventas anunció algo es un dato del mundo externo, no una
// evaluación privada de ningún equipo — todas las organizaciones lo ven
// igual. La app hace lectura delta con ?since= (mismo patrón que
// /me/decisions y /me/observations).
enum SaleAlertKind {
  NEW_SALE_DETECTED
  SYNC_STARTED
  CATALOG_NOW_AVAILABLE
}

model SaleAlert {
  id        String        @id @default(cuid())
  saleId    String
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  kind      SaleAlertKind
  message   String
  createdAt DateTime      @default(now())

  @@index([createdAt])
}

// Un Hip Number dentro de una venta, con los datos del catálogo tal como
// los publica la casa de ventas y la fecha de sesión ya resuelta.
model Hip {
  id                String   @id @default(cuid())
  saleId            String
  sale              Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  hipNumber         String
  horseName         String?
  sex               String?
  consignor         String?
  sire              String?
  dam               String?
  damSire           String?

  // Criador, año de nacimiento y color — NINGUNO de los dos viene en las
  // APIs de catálogo de Keeneland ni Fasig-Tipton (ver comentario en
  // syncCatalog, rankingService.ts): quedan nil hasta que exista una
  // segunda fuente (lectura de la página de catálogo pública, o carga a
  // mano) que sí los traiga. No se inventan ni se infieren — ver Historial
  // de Ventas más abajo (HorseSaleHistory), que los usa como parte de la
  // identificación del caballo entre ventas.
  breeder           String?
  foalYear          Int?
  color             String?

  // Fecha (día calendario) de la jornada en la que está programado
  // subastarse, ya resuelta — ver saleHouses/*.ts. Null = no se pudo
  // resolver todavía.
  sessionDate       DateTime?

  // Media tal como viene del catálogo (fotos y video), en JSON:
  // [{ kind: "photo"|"video", url: string, caption?: string }]
  mediaJson         Json     @default("[]")
  // Nota: la huella (hash) de la media analizada YA NO vive acá — bajo
  // multi-tenant, cada organización puede haber analizado el Hip en un
  // momento distinto, así que esa huella se guarda por-organización en
  // AnalysisResult.mediaHash (comparado vía el puntero CurrentHipAnalysis).
  // Ver analysis/mediaFingerprint.ts.

  // Resultado oficial de venta (precio, comprador, RNA/PS), tal como lo
  // va publicando la casa de ventas en vivo: { priceRaw?, purchaser?,
  // soldAsCode? }. Se actualiza en cada chequeo de catálogo, sin
  // necesidad de reanalizar nada — no afecta el puntaje del Método RM.
  saleResultJson    Json?

  lastCatalogSyncAt DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Historial completo de análisis de este Hip, de CUALQUIER organización
  // (cada fila ya sabe a qué organización pertenece vía
  // AnalysisResult.organizationId). El puntero al análisis "vigente" ya NO
  // vive acá — un mismo Hip puede tener un análisis vigente distinto por
  // organización (referentes distintos → puntajes distintos sobre las
  // mismas fotos), así que ese puntero pasó a la tabla CurrentHipAnalysis.
  analysisHistory   AnalysisResult[]
  currentAnalyses   CurrentHipAnalysis[]

  decisions         UserDecision[]
  observations      HipObservation[]

  // Historial de Ventas (ver HorseSaleHistory más abajo): apariciones
  // anteriores de este mismo caballo que se muestran cuando se abre ESTE
  // Hip (saleHistoryEntries), y las veces que ESTE Hip fue, a su vez, la
  // fuente de una entrada de historial de otro Hip más nuevo del mismo
  // caballo (saleHistorySourceFor) — dos relaciones separadas hacia Hip
  // porque HorseSaleHistory apunta a un Hip "actual" y, opcionalmente, a
  // otro Hip "fuente" (ver comentario en ese modelo).
  saleHistoryEntries   HorseSaleHistory[] @relation("HipSaleHistory")
  saleHistorySourceFor HorseSaleHistory[] @relation("HistorySourceHip")

  @@unique([saleId, hipNumber])
  @@index([saleId, sessionDate])
}

// De dónde salió una entrada del Historial de Ventas:
// - INTERNAL_HIP: RM Selection ya tenía este mismo caballo cargado como
//   otro Hip (de una venta anterior) y lo cruzó solo — la fuente más
//   confiable, porque es catálogo real que la propia RM Selection importó.
// - CATALOG_NOTE: se leyó de la página pública de catálogo (HTML), donde
//   el consignatario suele anotar una venta anterior del mismo ejemplar.
// - MANUAL: cargado a mano por el usuario.
// - LICENSED_LOOKUP: fuente de pago/licencia (ej. Equineline), solo si en
//   algún momento se autoriza — ver plan de Historial de Ventas.
enum SaleHistorySource {
  INTERNAL_HIP
  CATALOG_NOTE
  MANUAL
  LICENSED_LOOKUP
}

// Qué tan segura es la identificación de que la entrada de historial
// corresponde al MISMO caballo (ver principio de evidencia — nunca se
// mezclan dos caballos distintos a propósito):
// - CONFIRMED: identificadores fuertes coinciden (sire+dam+sexo+foalYear,
//   o lo publica el propio consignatario en la nota de catálogo).
// - LIKELY: coincidencia parcial (ej. sire+dam+sexo sin foalYear
//   confirmado) — se muestra, pero marcada como sin confirmar.
// - UNVERIFIED: cargada sin ningún cruce automático (ej. manual sin
//   evidencia adjunta).
enum SaleHistoryVerification {
  CONFIRMED
  LIKELY
  UNVERIFIED
}

// Una aparición anterior de un caballo en otra venta, asociada al Hip
// ACTUAL sobre el que se está consultando el Historial de Ventas (ver
// GET /api/v1/hips/sale-history). Cero, una o varias filas por Hip — nunca
// se sobrescribe, y nunca se inventa un precio o resultado que no venga de
// una fuente real (ver `source`/`priceRaw`/`resultCode`).
model HorseSaleHistory {
  id    String @id @default(cuid())
  hipId String
  hip   Hip    @relation("HipSaleHistory", fields: [hipId], references: [id], onDelete: Cascade)

  // Si la aparición anterior es otro Hip que RM Selection ya tiene en su
  // propia base (caso INTERNAL_HIP, el más confiable — ver comentario en
  // SaleHistorySource), se guarda la referencia directa acá en vez de
  // duplicar sus datos a mano.
  sourceHipId String?
  sourceHip   Hip?    @relation("HistorySourceHip", fields: [sourceHipId], references: [id], onDelete: SetNull)

  saleHouse      SaleHouse? // null = casa fuera de Keeneland/Fasig-Tipton/OBS
  saleHouseLabel String? // texto libre cuando saleHouse es null (ej. "Barretts")
  saleName       String
  saleYear       Int
  hipNumberAtSale String?
  // Tal cual lo publicó la casa de ventas — nunca inferido ni calculado.
  priceRaw       String?
  // "SOLD" | "RNA" | "OUT" | etc., tal cual publicado.
  resultCode     String?
  purchaser      String?

  source       SaleHistorySource
  verification SaleHistoryVerification
  // Qué identificadores coincidieron y por qué se consideró válido este
  // cruce (ej. {"sire": true, "dam": true, "foalYear": false}) — para
  // poder auditar o corregir un cruce que se haya hecho mal.
  matchBasis   Json?

  queriedAt       DateTime  @default(now())
  lastConfirmedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([hipId, saleHouse, saleYear, hipNumberAtSale])
  @@index([hipId])
}

// Resultado de análisis con IA para un Hip: las 26 subcategorías del
// Método RM, el puntaje general y la clasificación sugerida. YA NO se
// sobrescribe — cada reanálisis (ej. porque apareció una foto/video nuevo
// antes de la subasta) agrega una fila nueva, y el puntero en
// CurrentHipAnalysis se actualiza para apuntar a la más reciente. Así queda
// historial completo de cómo evolucionó la evaluación de cada Hip, no solo
// el último puntaje.
//
// Scopeado por organizationId (a diferencia de Sale/Hip, que son
// catálogo global): el mismo Hip puede tener un AnalysisResult distinto
// por organización, porque cada organización puede tener su propio
// caballo referente (ver ReferenceHorse) y por lo tanto llegar a un
// puntaje distinto sobre exactamente las mismas fotos.
model AnalysisResult {
  id             String       @id @default(cuid())
  hipId          String
  hip            Hip          @relation(fields: [hipId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Punteros que apuntan a ESTA fila como el análisis vigente de su
  // Hip+organización (normalmente una sola, ver CurrentHipAnalysis).
  currentFor     CurrentHipAnalysis[]

  // Número de versión secuencial dentro del Hip+organización (1, 2, 3...)
  // — más legible que ordenar por timestamp para mostrar "análisis #3".
  version               Int      @default(1)
  // Por qué se disparó este análisis: "initial" | "media_changed" | "manual".
  triggerReason         String   @default("initial")
  // Huella de la media (fotos/video) que se usó en ESTE análisis puntual —
  // permite saber después exactamente qué contenido produjo qué puntaje,
  // más preciso que solo guardar el hash "actual" en Hip.
  mediaHash             String?

  // Las 26 subcategorías (functional.*, limb.*, gait.*) puntaje 0-10.
  conformationScoresJson Json
  overallScore          Float
  classification        String   // "Comprar" | "Revisar" | "Descartar"
  summary               String?

  // Diagnóstico técnico (opcional, para depurar calidad del análisis):
  // cuántos fotogramas de marcha se pudieron usar y de qué duración.
  gaitFrameCount        Int?
  gaitVideoDurationSec  Float?

  analyzedAt            DateTime @default(now())
  // Modelo usado (para poder re-analizar todo si se cambia de versión).
  model                  String

  @@index([overallScore])
  @@index([hipId, analyzedAt])
  @@index([organizationId, hipId, analyzedAt])
}

// Puntero al análisis VIGENTE de un Hip PARA UNA ORGANIZACIÓN dada — evita
// tener que hacer `ORDER BY version DESC LIMIT 1` en cada lectura del
// ranking/ficha. Reemplaza al viejo `Hip.currentAnalysisId` (que solo podía
// apuntar a UN análisis vigente por Hip en total): bajo multi-tenant, un
// mismo Hip puede tener un análisis vigente distinto por organización.
model CurrentHipAnalysis {
  id             String         @id @default(cuid())
  hipId          String
  hip            Hip            @relation(fields: [hipId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  analysisResultId String
  analysisResult AnalysisResult @relation(fields: [analysisResultId], references: [id], onDelete: Cascade)
  updatedAt      DateTime       @updatedAt

  @@unique([hipId, organizationId])
}

// Decisión final del usuario sobre un Hip ("Comprar"/"Revisar"/"Descartar"
// + notas). Antes vivía SOLO en SwiftData local (por eso no sincronizaba
// entre el iPad y el iPhone) — ahora el servidor es la fuente de verdad;
// el dispositivo queda como caché offline. Resolución de conflictos: el
// más reciente gana (por updatedAt) — alcanza para el patrón de uso real
// (un comprador, normalmente un dispositivo activo a la vez).
model UserDecision {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Denormalizado desde User.organizationId: se podría derivar siempre vía
  // userId → User, pero tenerlo acá también permite filtrar/indexar
  // decisiones por organización directamente (y es una segunda barrera de
  // defensa: un bug que arme mal el `where` de una query no puede filtrar
  // datos de otra organización sin este campo).
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hipId      String
  hip        Hip       @relation(fields: [hipId], references: [id], onDelete: Cascade)
  deviceId   String?
  device     Device?   @relation(fields: [deviceId], references: [id])

  finalCall  String    // "Comprar" | "Revisar" | "Descartar"
  notes      String?
  decidedAt  DateTime  @default(now())

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  // Tombstone en vez de borrado físico: un dispositivo que estaba offline
  // cuando se borró una decisión en otro necesita enterarse del borrado en
  // la próxima sincronización, no solo de altas/cambios.
  deletedAt  DateTime?

  @@unique([userId, hipId])
}

// Observación de texto libre del usuario sobre un Hip — mismo criterio de
// sincronización que UserDecision (servidor como fuente de verdad,
// tombstone para borrados). Las observaciones generadas por IA siguen
// viviendo en AnalysisResult.summary, no acá — esta tabla es solo para las
// que escribe la persona.
model HipObservation {
  id         String               @id @default(cuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Ver comentario equivalente en UserDecision.organizationId.
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hipId      String
  hip        Hip                  @relation(fields: [hipId], references: [id], onDelete: Cascade)
  deviceId   String?
  device     Device?              @relation(fields: [deviceId], references: [id])

  text       String
  category   ObservationCategory?

  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  deletedAt  DateTime?

  @@index([userId, hipId])
}

// El ranking ya armado y ordenado para una venta+jornada — lo que la app
// de iOS lee directamente, sin tener que recalcular nada. Se regenera
// automáticamente 12 horas antes de la sesión y cada vez que un Hip
// afectado se reanaliza.
model RankingSnapshot {
  id             String       @id @default(cuid())
  saleId         String
  sale           Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  // Cada organización arma su propio ranking sobre el mismo catálogo
  // (Sale/Hip global), porque cada una puede tener su propio caballo
  // referente y por lo tanto su propio orden/puntaje.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Día calendario de la jornada que representa este ranking.
  sessionDate    DateTime

  // [{ rank, hipNumber, overallScore, classification }], ya ordenado.
  entriesJson    Json
  totalHipsToday Int

  generatedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, saleId, sessionDate])
}

// Historial de versiones del ranking: una fila nueva CADA VEZ que se
// recalcula (a diferencia de RankingSnapshot, que se sobrescribe y solo
// guarda la versión vigente). Permite mostrar más adelante "cómo cambió el
// top 20 a lo largo del día" — reconstruir esto de forma retroactiva sin
// haberlo capturado no sería posible, así que se guarda desde ahora aunque
// todavía no haya ninguna pantalla que lo muestre.
model RankingSnapshotVersion {
  id             String       @id @default(cuid())
  saleId         String
  sale           Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  sessionDate    DateTime
  entriesJson    Json
  totalHipsToday Int
  // Por qué se disparó esta actualización del ranking: "initial" |
  // "media_changed" | "scheduled_refresh".
  triggerReason  String   @default("initial")

  generatedAt    DateTime @default(now())

  @@index([organizationId, saleId, sessionDate, generatedAt])
}

// Registro de cada ciclo del scheduler — visibilidad operativa mínima
// (Railway rota los logs, esto no). Sirve para poder responder "¿qué pasó
// anoche a las 3am, por qué no se generó el ranking?" sin depender de
// haber tenido los logs abiertos en ese momento.
model SchedulerRun {
  id             String    @id @default(cuid())
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  salesProcessed Int       @default(0)
  analysesRun    Int       @default(0)
  errorMessage   String?

  @@index([startedAt])
}

// Fotos (y, opcionalmente, video de marcha) del caballo referente del
// Método RM — el patrón oficial contra el que se compara cada Hip. Se
// carga una sola vez desde un panel de administración simple; el backend
// la usa en cada análisis, así que no hace falta configurarla por
// dispositivo como pasaba en la versión on-device.
//
// Scopeada por organización: cada organización puede definir su propio
// patrón referente (por eso AnalysisResult también está scopeado — el
// mismo Hip puede puntuar distinto para cada una).
model ReferenceHorse {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // "default" hoy — un solo patrón activo a la vez por organización. Se
  // deja como string (no un booleano "isActive") por si en el futuro RM
  // Selection quiere patrones distintos por raza/tipo de venta dentro de
  // una misma organización.
  key            String       @default("default")
  photoUrls      Json         @default("[]") // string[]
  gaitVideoUrl   String?
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
}
