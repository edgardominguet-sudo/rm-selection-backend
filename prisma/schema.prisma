// Esquema de base de datos del backend de RM Selection.
//
// Idea general: el backend es la única fuente de verdad del Ranking del
// Día. Descarga catálogos, resuelve automáticamente qué Hip corresponde a
// qué jornada, dispara el análisis con IA 12 horas antes de cada sesión, y
// guarda tanto el resultado de cada Hip como el ranking ya armado — la app
// de iOS solo lee esta base a través de la API, nunca vuelve a correr IA
// por su cuenta.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SaleHouse {
  FASIG_TIPTON
  KEENELAND
  OBS
}

enum UserRole {
  OWNER
  ADMIN
  BUYER
}

enum ObservationCategory {
  CONFORMATION
  MOVEMENT
  PEDIGREE
  GENERAL
}

// De dónde salió un AnalysisResult — a pedido (2026-08-08, sincronización
// multidispositivo): antes todo análisis era de IA. Ahora un usuario puede
// cargar/corregir un puntaje a mano desde cualquier dispositivo, y ese
// puntaje tiene que sincronizarse igual que uno de IA — se modela como una
// versión más dentro del mismo historial (AnalysisResult), no como una
// tabla paralela, así se reusa el mecanismo de versión/puntero vigente
// (CurrentHipAnalysis) que ya existe y ya está bien probado.
enum AnalysisSource {
  AI
  MANUAL
}

// Tipo de archivo multimedia que un usuario agrega a mano a un Hip (no el
// que ya viene del catálogo de la casa de ventas — eso sigue viviendo en
// Hip.mediaJson). Mismos 4 tipos que ya distingue la app en
// MediaItem.Kind (iOS) — se mantiene la misma nomenclatura para que el
// mapeo cliente/servidor sea directo.
enum MediaKind {
  PHOTO
  VIDEO
  VET_REPORT
  PEDIGREE_CHART
  // Fotos tomadas EXCLUSIVAMENTE desde la pantalla Análisis (IA) para ese
  // Hip (2026-08-13, regla dura del Método RM: el motor de análisis nunca
  // debe usar fotos de Media ni del catálogo). Se guardan como MediaAsset
  // igual que cualquier otro tipo — la diferencia es que SOLO estas
  // alimentan analyzeHip/analyzeHipOnDemand (ver rankingService.ts).
  AI_ANALYSIS_PHOTO
}

// Estado de subida de un MediaAsset visto desde el backend — normalmente
// un asset solo llega a existir en esta tabla cuando ya está en
// PROCESSED (la app confirma después de subir el archivo al storage), pero
// se deja el estado explícito para poder detectar/limpiar asset huérfanos
// (se pidió una URL pre-firmada y nunca se confirmó la subida).
enum MediaUploadStatus {
  PENDING_UPLOAD
  PROCESSED
  FAILED
}

// Un "equipo de trabajo" o comprador independiente. Hoy existe una sola
// Organization (tu equipo, todos viendo el mismo análisis) — pero el día
// que RM Selection sume compradores que no deben ver las decisiones,
// observaciones ni puntajes de otros (porque cada uno puede tener su
// propio caballo referente y por lo tanto sus propios resultados sobre el
// mismo Hip), no hace falta ninguna migración estructural: alcanza con dar
// de alta una Organization nueva. Todo lo que es "catálogo puro" (Sale,
// Hip) queda A PROPÓSITO fuera de esta tabla — ver comentario en Hip.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                   User[]
  analysisResults         AnalysisResult[]
  currentHipAnalyses      CurrentHipAnalysis[]
  rankingSnapshots        RankingSnapshot[]
  rankingSnapshotVersions RankingSnapshotVersion[]
  referenceHorses         ReferenceHorse[]
  referenceHorsePhotos    ReferenceHorsePhoto[]
  decisions               UserDecision[]
  observations            HipObservation[]
  vetReports              VetReport[]
  mediaAssets             MediaAsset[]
  pedigreeAnnotations     PedigreeAnnotation[]
  recentHipVisits         RecentHipVisit[]
}

// Un usuario de RM Selection. Hoy hay uno solo (vos), pero se modela desde
// ahora — sin esto, "sincronizar entre dispositivos" y "cuentas futuras" no
// tienen dónde anclarse, y agregarlo más adelante significaría migrar datos
// reales en vez de partir de una base limpia.
model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email       String?  @unique
  // Reemplaza a la clave compartida suelta (APP_API_KEY): la misma clave
  // ahora identifica a un usuario concreto, así cada decisión/observación
  // que se guarda queda asociada a alguien desde el primer día, sin tener
  // que construir login todavía. Login real (email/contraseña, magic link)
  // se agrega el día que haga falta una segunda persona con cuenta propia.
  apiKey      String?  @unique
  displayName String?
  role        UserRole @default(OWNER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  devices     Device[]
  decisions   UserDecision[]
  observations HipObservation[]
  catalogImports CatalogImport[]
  vetReports    VetReport[]
  mediaAssets   MediaAsset[]
  pedigreeAnnotations PedigreeAnnotation[]
  recentHipVisits RecentHipVisit[]
}

// Un dispositivo (iPhone/iPad) desde el que un usuario usa la app. Deja
// lista la base para notificaciones push futuras ("se actualizó el
// ranking") y para saber desde qué dispositivo se tomó cada decisión —
// capturar esto desde el día uno es gratis; reconstruirlo después de que ya
// existan decisiones/observaciones sin esa procedencia no lo es.
model Device {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform    String    // "ios" (hoy); deja lugar a otras plataformas a futuro.
  deviceName  String?   // ej. "iPad de Ramon"
  appVersion  String?
  // Token de notificaciones push (APNs) — nil hasta que se construya esa
  // integración; la columna ya queda lista para no migrar de nuevo después.
  pushToken   String?
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())

  decisions   UserDecision[]
  observations HipObservation[]
  vetReports    VetReport[]
  mediaAssets   MediaAsset[]
  pedigreeAnnotations PedigreeAnnotation[]
  recentHipVisits RecentHipVisit[]
}

// Qué tan utilizable es el catálogo estructurado de una venta:
// - FULL: hay una API de catálogo que se puede consultar directo (Keeneland
//   siempre; Fasig-Tipton cuando se conoce el ID numérico interno). El
//   scheduler la sincroniza sola (syncCatalog) y analiza normalmente.
// - MANUAL_CSV: la casa de ventas NO tiene ninguna API pública de catálogo
//   (hoy, OBS — se investigó a fondo el 2026-08-05: su catálogo real vive en
//   obscatalog.com, pero se renderiza 100% del lado del cliente vía
//   JavaScript/AJAX, sin ningún endpoint JSON/XML público identificable; no
//   hay Content-Type de datos en el HTML servidor, solo una tabla vacía que
//   se llena después. No hay forma automática y respetuosa de leerlo hoy).
//   En vez de quedar en un callejón sin salida permanente, el catálogo se
//   carga vía POST /sales/:saleId/catalog/import con un CSV/export (el mismo
//   formato que ya usan estas casas de venta para consignatarios/compradores
//   — ver saleHouses/manualCatalogImport.ts) — a partir de ahí, el Hip
//   generado pasa por EXACTAMENTE el mismo camino que un Hip de Keeneland o
//   Fasig-Tipton: análisis con IA, Ranking del Día, Historial de Ventas,
//   detección de media nueva en el próximo import. Solo el paso de "traer el
//   catálogo" es manual — todo lo de ahí en adelante sigue siendo automático.
// - PENDING_ID: se detectó el anuncio público (nombre, fechas) pero falta
//   resolver el ID interno que pide la API de catálogo — hoy pasa con
//   Fasig-Tipton, cuyo ID numérico no aparece en ninguna página pública,
//   solo se puede obtener inspeccionando la app oficial/portal del
//   comprador. Se investigó de nuevo el 2026-08-05: el parámetro
//   `sale_start_date` que sí acepta `django/api/filtered_pedigree_pdf/`
//   (visible en URLs indexadas por buscadores) NO funciona en
//   `django/api/horses/` (devuelve vacío); `django/api/sales/` existe (200,
//   no 404) pero devuelve `{}` con cualquier filtro probado — no hay bypass
//   público conocido. No se adivina el ID por fuerza bruta (violaría el
//   acceso autorizado) — queda visible en /api/v1/alerts hasta que alguien
//   cargue el ID real vía POST /sales. MANUAL_CSV queda disponible como
//   alternativa si alguien quiere estos Hips analizados ANTES de conseguir
//   el ID real (ver comentario arriba) — completar el ID real más adelante
//   simplemente pasa la venta a FULL sin perder nada de lo ya importado.
// - UNAVAILABLE: reservado para una casa de ventas sin NINGÚN camino de
//   acceso, ni siquiera manual (ej. ni catálogo público ni export
//   descargable en ningún formato) — hoy ninguna casa soportada cae en este
//   caso; ver saleHouses/discovery/obsDiscovery.ts.
enum SaleCatalogAccess {
  FULL
  MANUAL_CSV
  PENDING_ID
  UNAVAILABLE
}

// Una venta concreta (ej. "Fasig-Tipton — Saratoga 2026"). Hasta ahora se
// daba de alta a mano; ahora también puede crearla sola el descubrimiento
// automático (ver saleDiscoveryService.ts) apenas la casa de ventas la
// anuncia públicamente — a partir de ahí, todo lo demás (catálogo,
// sesiones, Hips, ranking) se resuelve solo, igual que antes.
//
// Sale y Hip quedan GLOBALES — sin organizationId — a propósito: son datos
// de catálogo público (nombre, consignatario, fotos tal como las publica
// la casa de ventas), iguales para cualquier organización que los mire. Si
// se scopearan por organización, cada organización nueva dispararía un
// scraping duplicado del mismo catálogo público. Lo que SÍ varía por
// organización es la EVALUACIÓN de ese catálogo (AnalysisResult y todo lo
// derivado) — ver comentario en AnalysisResult.
model Sale {
  id                 String     @id @default(cuid())
  house              SaleHouse
  name               String
  // ID interno que usa la API de catálogo de la casa de ventas. Para
  // ventas con catalogAccess distinto de FULL, esto es un identificador
  // SINTÉTICO (derivado del slug del anuncio público, no un ID real de
  // catálogo) — solo sirve para no duplicar la fila en @@unique([house,
  // externalSaleId]) hasta que se resuelva el ID de verdad.
  externalSaleId     String
  // Fecha real de la jornada (o del primer día, si la venta dura varios)
  // tal como la publica la casa de ventas. Se completa apenas se detecta
  // el anuncio (con la fecha que trae el anuncio público) y se refina
  // sola más precisa una vez que el catálogo trae Hips con sessionDate
  // resuelto (ver syncCatalog en rankingService.ts) — así el orden
  // cronológico entre casas queda bien desde el día uno, sin depender de
  // que el catálogo ya esté disponible. Null solo si todavía no se pudo
  // leer ninguna fecha confiable (no se inventa).
  startDate          DateTime?
  // Último día calendario de la venta (inclusive) — igual criterio que
  // startDate: se completa apenas se puede leer un rango confiable del
  // anuncio público (ver saleHouses/discovery/dateParsing.ts) y se refina
  // sola con la sessionDate MÁS TARDÍA una vez que el catálogo trae Hips
  // con fecha de sesión resuelta (mismo mecanismo que ya refina startDate
  // con la más temprana, ver syncCatalog en rankingService.ts). Null solo
  // si nunca se pudo leer ningún rango (nunca se inventa) — GET /sales la
  // devuelve entonces como `startDate` (venta de un solo día conocido)
  // para que el cliente (app) siempre reciba un rango válido. Agregado
  // 2026-08-26 para que RM Selection arme el selector de ventas 100% desde
  // el servidor (Keeneland/Fasig-Tipton/OBS), sin ninguna fecha fija
  // hardcodeada en el cliente (ver SaleOption.swift del lado de la app).
  endDate            DateTime?
  // Solo Keeneland: año + slug de la venta en la URL pública del
  // "Schedule of Sale", para poder resolver fecha de sesión por Hip sin
  // que el usuario cargue nada a mano (ver saleHouses/keenelandSchedule.ts).
  scheduleYear       Int?
  scheduleSlug       String?
  isActive           Boolean    @default(true)
  // Último momento en que se volvió a consultar el catálogo completo de
  // esta venta contra la casa de ventas. El scheduler decide CUÁNDO toca
  // volver a chequear según qué tan cerca esté la próxima jornada (ver
  // scheduler.ts / pollingPolicy.ts) — no chequea a un intervalo fijo
  // siempre, para no golpear la API de la casa de ventas más de lo
  // necesario cuando falta mucho, y chequear mucho más seguido cuando la
  // subasta está por arrancar o en curso.
  lastCatalogCheckAt DateTime?
  // null = dada de alta a mano (POST /sales, como hasta ahora). No-null =
  // la creó sola el descubrimiento automático, y este es el momento en que
  // se detectó el anuncio público por primera vez.
  discoveredAt       DateTime?
  // Link a la página/anuncio público donde se detectó — para poder
  // verificarla a simple vista desde /api/v1/alerts o el panel.
  announcementUrl    String?
  catalogAccess      SaleCatalogAccess @default(FULL)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  hips                    Hip[]
  rankingSnapshots        RankingSnapshot[]
  rankingSnapshotVersions RankingSnapshotVersion[]
  alerts                  SaleAlert[]
  catalogImports          CatalogImport[]
  saleDays                SaleDay[]

  @@unique([house, externalSaleId])
}

// Calendario de la venta: un día real de subasta (jornada) con su Book,
// horario y rango de Hip — lo que necesita el "Calendario de Ventas" de la
// app para mostrar Fecha → Libro → rango de Hip sin que nadie lo cargue a
// mano. Genérico por casa (no específico de Keeneland): cada
// SaleHouseClient que sepa resolverlo publica sus propias filas acá vía
// resolveSaleDays() (ver types.ts) — Keeneland lo resuelve leyendo el PDF
// oficial "Hip Grouping" de la venta (keenelandHipGrouping.ts), Fasig-Tipton
// y OBS pueden sumar su propia fuente después sin tocar este modelo.
// Nunca se inventa una fila: si una casa no puede resolver el dato real
// todavía, simplemente no hay filas para esa venta (la UI lo trata como
// "calendario no disponible todavía", no como error).
model SaleDay {
  id            String   @id @default(cuid())
  saleId        String
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  date          DateTime
  book          String?
  sessionNumber Int?
  // Hora de inicio tal como la publica la casa (ej. "10:00 am"), en texto
  // crudo — no se reconstruye una hora con huso horario inventado.
  startTimeLabel String?
  hipRangeStart String?
  hipRangeEnd   String?
  headCount     Int?
  // De dónde salió esta fila (ej. "KEENELAND_HIP_GROUPING_PDF") — para
  // poder diagnosticar sin adivinar cuando el dato se vea raro.
  source        String

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([saleId, date])
}

// Auditoría de cada carga manual de catálogo (ver SaleCatalogAccess.MANUAL_CSV
// y saleHouses/manualCatalogImport.ts) — deja registro de cuándo se cargó,
// quién lo cargó, cuántas filas trajo el archivo y cuántos Hips efectivamente
// se crearon/actualizaron, más cualquier advertencia de filas descartadas
// (ej. sin "Hip Number", fecha de sesión no parseable). Nunca se borra: es
// el equivalente de SchedulerRun para el camino manual, útil para responder
// "¿de dónde salió este dato?" o diagnosticar un import que trajo menos Hips
// de los esperados.
model CatalogImport {
  id             String   @id @default(cuid())
  saleId         String
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  importedByUserId String?
  importedByUser User?    @relation(fields: [importedByUserId], references: [id], onDelete: SetNull)

  fileName       String?
  rowCount       Int
  hipsCreated    Int
  hipsUpdated    Int
  // Filas descartadas o advertencias no fatales (ej. "fila 14: sin Hip
  // Number, se descarta", "fila 30: Session Date no parseable, se usó la
  // fecha de la venta"). Nunca detiene el import completo — una fila mala no
  // debe tirar abajo las 200 buenas.
  warningsJson   Json     @default("[]")

  createdAt      DateTime @default(now())

  @@index([saleId, createdAt])
}

// Registro de "novedades" — lo que la app le muestra al usuario cuando el
// descubrimiento automático encuentra una venta nueva o empieza a
// sincronizarla. Global (no por organización), igual que Sale: el hecho de
// que una casa de ventas anunció algo es un dato del mundo externo, no una
// evaluación privada de ningún equipo — todas las organizaciones lo ven
// igual. La app hace lectura delta con ?since= (mismo patrón que
// /me/decisions y /me/observations).
enum SaleAlertKind {
  NEW_SALE_DETECTED
  SYNC_STARTED
  CATALOG_NOW_AVAILABLE
  // Se genera cuando el método primario de chequeo (la API de catálogo en
  // vivo) contesta "sin datos" pero la fecha de la venta ya está encima
  // (dentro de CATALOG_CHECK_WARNING_DAYS, ver rankingService.ts) — señal
  // de que puede no tratarse de "todavía no publicado" sino de un problema
  // real del mecanismo (ID equivocado, endpoint cambiado, etc.) que
  // conviene revisar a mano en vez de asumir silenciosamente que está
  // todo bien (a pedido, 2026-08-12: "no confundir catálogo no publicado
  // con no localizado por el método primario").
  CATALOG_CHECK_INCONCLUSIVE
}

model SaleAlert {
  id        String        @id @default(cuid())
  saleId    String
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  kind      SaleAlertKind
  message   String
  createdAt DateTime      @default(now())

  @@index([createdAt])
}

// Un Hip Number dentro de una venta, con los datos del catálogo tal como
// los publica la casa de ventas y la fecha de sesión ya resuelta.
model Hip {
  id                String   @id @default(cuid())
  saleId            String
  sale              Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  hipNumber         String
  horseName         String?
  sex               String?
  consignor         String?
  // Establo (Barn) donde está alojado el yearling durante la venta —
  // CORRECCIÓN 2026-08-15: existía en el modelo de dominio de la app
  // (RMSelection/Models/Hip.swift) y en los mapeos viejos por casa
  // (Hip+FasigTiptonMapping.swift, Hip+CatalogMapping.swift de Keeneland),
  // pero nunca se agregó acá ni al contrato genérico NormalizedHip
  // (types.ts) cuando se generalizó el importador por casa (provider
  // pattern) — así que TODA venta que pasa por el camino nuevo
  // (BackendCatalogHipDataService en iOS, el único que usan las ventas
  // activas hoy) perdía el dato sin que ningún importador rompiera ni
  // avisara. Mismo criterio que breeder/foalYear/color: opcional, cada
  // casa lo completa si su fuente lo publica.
  barn              String?
  sire              String?
  dam               String?
  damSire           String?

  // Criador, año de nacimiento y color — NINGUNO de los dos viene en las
  // APIs de catálogo de Keeneland ni Fasig-Tipton (ver comentario en
  // syncCatalog, rankingService.ts): quedan nil hasta que exista una
  // segunda fuente (lectura de la página de catálogo pública, o carga a
  // mano) que sí los traiga. No se inventan ni se infieren — ver Historial
  // de Ventas más abajo (HorseSaleHistory), que los usa como parte de la
  // identificación del caballo entre ventas.
  breeder           String?
  foalYear          Int?
  color             String?

  // Fecha (día calendario) de la jornada en la que está programado
  // subastarse, ya resuelta — ver saleHouses/*.ts. Null = no se pudo
  // resolver todavía.
  sessionDate       DateTime?

  // Media tal como viene del catálogo (fotos y video), en JSON:
  // [{ kind: "photo"|"video", url: string, caption?: string }]
  mediaJson         Json     @default("[]")
  // Nota: la huella (hash) de la media analizada YA NO vive acá — bajo
  // multi-tenant, cada organización puede haber analizado el Hip en un
  // momento distinto, así que esa huella se guarda por-organización en
  // AnalysisResult.mediaHash (comparado vía el puntero CurrentHipAnalysis).
  // Ver analysis/mediaFingerprint.ts.

  // Resultado oficial de venta (precio, comprador, RNA/PS), tal como lo
  // va publicando la casa de ventas en vivo: { priceRaw?, purchaser?,
  // soldAsCode? }. Se actualiza en cada chequeo de catálogo, sin
  // necesidad de reanalizar nada — no afecta el puntaje del Método RM.
  saleResultJson    Json?

  lastCatalogSyncAt DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Historial completo de análisis de este Hip, de CUALQUIER organización
  // (cada fila ya sabe a qué organización pertenece vía
  // AnalysisResult.organizationId). El puntero al análisis "vigente" ya NO
  // vive acá — un mismo Hip puede tener un análisis vigente distinto por
  // organización (referentes distintos → puntajes distintos sobre las
  // mismas fotos), así que ese puntero pasó a la tabla CurrentHipAnalysis.
  analysisHistory   AnalysisResult[]
  currentAnalyses   CurrentHipAnalysis[]

  decisions         UserDecision[]
  observations      HipObservation[]
  vetReports        VetReport[]
  mediaAssets       MediaAsset[]
  pedigreeAnnotations PedigreeAnnotation[]
  recentHipVisits   RecentHipVisit[]

  // Historial de Ventas (ver HorseSaleHistory más abajo): apariciones
  // anteriores de este mismo caballo que se muestran cuando se abre ESTE
  // Hip (saleHistoryEntries), y las veces que ESTE Hip fue, a su vez, la
  // fuente de una entrada de historial de otro Hip más nuevo del mismo
  // caballo (saleHistorySourceFor) — dos relaciones separadas hacia Hip
  // porque HorseSaleHistory apunta a un Hip "actual" y, opcionalmente, a
  // otro Hip "fuente" (ver comentario en ese modelo).
  saleHistoryEntries   HorseSaleHistory[] @relation("HipSaleHistory")
  saleHistorySourceFor HorseSaleHistory[] @relation("HistorySourceHip")

  // Registros permanentes de OfficialSaleResult que se originaron leyendo
  // ESTE Hip (ver comentario en ese modelo) — puramente informativo, no se
  // borra en cascada si este Hip se borra.
  officialResultSourceFor OfficialSaleResult[] @relation("OfficialResultSourceHip")

  @@unique([saleId, hipNumber])
  @@index([saleId, sessionDate])
}

// De dónde salió una entrada del Historial de Ventas:
// - INTERNAL_HIP: RM Selection ya tenía este mismo caballo cargado como
//   otro Hip (de una venta anterior) y lo cruzó solo — la fuente más
//   confiable, porque es catálogo real que la propia RM Selection importó.
// - CATALOG_NOTE: se leyó de la página pública de catálogo (HTML), donde
//   el consignatario suele anotar una venta anterior del mismo ejemplar.
// - MANUAL: cargado a mano por el usuario.
// - LICENSED_LOOKUP: fuente de pago/licencia (ej. Equineline), solo si en
//   algún momento se autoriza — ver plan de Historial de Ventas.
enum SaleHistorySource {
  INTERNAL_HIP
  CATALOG_NOTE
  MANUAL
  LICENSED_LOOKUP
}

// Qué tan segura es la identificación de que la entrada de historial
// corresponde al MISMO caballo (ver principio de evidencia — nunca se
// mezclan dos caballos distintos a propósito):
// - CONFIRMED: identificadores fuertes coinciden (sire+dam+sexo+foalYear,
//   o lo publica el propio consignatario en la nota de catálogo).
// - LIKELY: coincidencia parcial (ej. sire+dam+sexo sin foalYear
//   confirmado) — se muestra, pero marcada como sin confirmar.
// - UNVERIFIED: cargada sin ningún cruce automático (ej. manual sin
//   evidencia adjunta).
enum SaleHistoryVerification {
  CONFIRMED
  LIKELY
  UNVERIFIED
}

// Una aparición anterior de un caballo en otra venta, asociada al Hip
// ACTUAL sobre el que se está consultando el Historial de Ventas (ver
// GET /api/v1/hips/sale-history). Cero, una o varias filas por Hip — nunca
// se sobrescribe, y nunca se inventa un precio o resultado que no venga de
// una fuente real (ver `source`/`priceRaw`/`resultCode`).
model HorseSaleHistory {
  id    String @id @default(cuid())
  hipId String
  hip   Hip    @relation("HipSaleHistory", fields: [hipId], references: [id], onDelete: Cascade)

  // Si la aparición anterior es otro Hip que RM Selection ya tiene en su
  // propia base (caso INTERNAL_HIP, el más confiable — ver comentario en
  // SaleHistorySource), se guarda la referencia directa acá en vez de
  // duplicar sus datos a mano.
  sourceHipId String?
  sourceHip   Hip?    @relation("HistorySourceHip", fields: [sourceHipId], references: [id], onDelete: SetNull)

  saleHouse      SaleHouse? // null = casa fuera de Keeneland/Fasig-Tipton/OBS
  saleHouseLabel String? // texto libre cuando saleHouse es null (ej. "Barretts")
  saleName       String
  saleYear       Int
  hipNumberAtSale String?
  // Tal cual lo publicó la casa de ventas — nunca inferido ni calculado.
  priceRaw       String?
  // "SOLD" | "RNA" | "OUT" | etc., tal cual publicado.
  resultCode     String?
  purchaser      String?

  source       SaleHistorySource
  verification SaleHistoryVerification
  // Qué identificadores coincidieron y por qué se consideró válido este
  // cruce (ej. {"sire": true, "dam": true, "foalYear": false}) — para
  // poder auditar o corregir un cruce que se haya hecho mal.
  matchBasis   Json?

  queriedAt       DateTime  @default(now())
  lastConfirmedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([hipId, saleHouse, saleYear, hipNumberAtSale])
  @@index([hipId])
}

// TAREA 1 (2026-08-13): base histórica PROPIA de RM Selection — a
// diferencia de HorseSaleHistory (arriba), que vive COLGADA de un Hip
// puntual (se borra en cascada si ese Hip se borra) y sirve para el cruce
// "¿este mismo caballo ya pasó por acá?", OfficialSaleResult es un
// registro PERMANENTE e independiente del ciclo de vida de ningún Hip: el
// resultado oficial (vendido/precio/comprador, RNA, retirado/scratch, u
// otro estado tal cual lo publicó la casa) de un Hip puntual en una venta
// puntual, identificado por su llave natural (casa + venta + año + Hip
// Number) — no por una fila de Hip que algún día podría reimportarse o
// borrarse. Un catálogo se puede volver a importar mil veces; este
// registro no se duplica (upsert por la llave natural) y NUNCA se
// sobreescribe con un valor inventado — si la casa de ventas todavía no
// publicó nada, no se crea fila.
//
// Mantiene separados a propósito (instrucciones, punto 9):
//   Catálogo        -> Hip (datos previos: pedigree, consignatario, fotos)
//   Resultado de venta EN VIVO -> Hip.saleResultJson (efímero, ligado al
//                                 Hip actual de la venta activa)
//   Historial de Ventas PERMANENTE -> OfficialSaleResult (acá)
enum OfficialSaleResultCode {
  SOLD
  RNA
  SCRATCHED
  OTHER
}

model OfficialSaleResult {
  id String @id @default(cuid())

  saleHouse      SaleHouse? // null = casa fuera de Keeneland/Fasig-Tipton/OBS
  saleHouseLabel String?    // texto libre cuando saleHouse es null
  saleName       String
  saleYear       Int
  hipNumber      String

  // Identificación del caballo — tal cual la trajo el catálogo oficial en
  // el momento del resultado; nunca inferida.
  horseName String?
  sire      String?
  dam       String?
  consignor String?

  // Tal cual lo publicó la casa de ventas — nunca inferido ni calculado.
  // Ej. en Fasig-Tipton este código NO indica vendido/RNA/retirado (viene
  // "Y" para casi cualquier Hip con actividad) — el estado real hay que
  // leerlo de `purchaser` (ver classifyResultCode en
  // officialSaleResultService.ts). Se guarda igual, tal cual, para no
  // perder el dato crudo de la fuente.
  priceRaw   String?
  resultCode String?
  purchaser  String?
  // Clasificación normalizada de 4 estados (SOLD/RNA/SCRATCHED/OTHER) —
  // esto SÍ es una inferencia de RM Selection a partir de `purchaser` +
  // `resultCode` + `priceRaw` (nunca un dato que la casa de ventas publique
  // tal cual con este nombre), separada a propósito del campo `resultCode`
  // de arriba para no mezclar "hecho observable" con "inferencia
  // razonable" (principio de evidencia).
  normalizedStatus OfficialSaleResultCode?

  // Referencia opcional al Hip de RM Selection del que se leyó este
  // resultado — SOLO informativa (para poder auditar de dónde salió).
  // onDelete: SetNull a propósito: si ese Hip se borra o el catálogo se
  // reimporta con otro id, este registro histórico NO desaparece (punto 7:
  // "al incorporar ventas futuras, no borrar ni sustituir resultados
  // anteriores").
  sourceHipId String?
  sourceHip   Hip?    @relation("OfficialResultSourceHip", fields: [sourceHipId], references: [id], onDelete: SetNull)

  firstRecordedAt DateTime  @default(now())
  lastConfirmedAt DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([saleHouse, saleName, saleYear, hipNumber])
  @@index([sire, dam])
  @@index([saleYear, saleHouse])
}

// Resultado de análisis con IA para un Hip: las 26 subcategorías del
// Método RM, el puntaje general y la clasificación sugerida. YA NO se
// sobrescribe — cada reanálisis (ej. porque apareció una foto/video nuevo
// antes de la subasta) agrega una fila nueva, y el puntero en
// CurrentHipAnalysis se actualiza para apuntar a la más reciente. Así queda
// historial completo de cómo evolucionó la evaluación de cada Hip, no solo
// el último puntaje.
//
// Scopeado por organizationId (a diferencia de Sale/Hip, que son
// catálogo global): el mismo Hip puede tener un AnalysisResult distinto
// por organización, porque cada organización puede tener su propio
// caballo referente (ver ReferenceHorse) y por lo tanto llegar a un
// puntaje distinto sobre exactamente las mismas fotos.
model AnalysisResult {
  id             String       @id @default(cuid())
  hipId          String
  hip            Hip          @relation(fields: [hipId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Punteros que apuntan a ESTA fila como el análisis vigente de su
  // Hip+organización (normalmente una sola, ver CurrentHipAnalysis).
  currentFor     CurrentHipAnalysis[]

  // Número de versión secuencial dentro del Hip+organización (1, 2, 3...)
  // — más legible que ordenar por timestamp para mostrar "análisis #3".
  version               Int      @default(1)
  // Por qué se disparó este análisis: "initial" | "media_changed" | "manual".
  triggerReason         String   @default("initial")
  // AI (default, siempre fue así) o MANUAL — a pedido (2026-08-08,
  // sincronización multidispositivo): un usuario puede cargar/corregir un
  // puntaje a mano desde cualquier dispositivo. Se guarda como una versión
  // más en el mismo historial en vez de una tabla paralela, para reusar
  // el puntero CurrentHipAnalysis y el mecanismo de versión que ya existe.
  source                AnalysisSource @default(AI)
  // Quién cargó el puntaje manual (null para análisis de IA).
  enteredByUserId        String?
  deviceId               String?
  // Huella de la media (fotos/video) que se usó en ESTE análisis puntual —
  // permite saber después exactamente qué contenido produjo qué puntaje,
  // más preciso que solo guardar el hash "actual" en Hip.
  mediaHash             String?

  // Puntajes de conformación de este análisis. Forma depende de
  // `methodologyVersion`: filas viejas (methodologyVersion = null) tienen
  // las 26 subcategorías legado (functional.*, limb.*, gait.*); filas
  // nuevas (methodologyVersion = "rm-anatomical-2026-08") tienen los 9
  // parámetros de anatomía comparativa (lateral.*, frontal.*, posterior.*)
  // — ver src/analysis/conformationScores.ts. NUNCA se reescribe una fila
  // vieja para "migrarla" al nuevo formato: el referente con el que se
  // calculó ya no existe, así que ese puntaje histórico simplemente deja
  // de mostrarse como vigente (el Hip pasa a necesitar un análisis nuevo).
  conformationScoresJson Json
  overallScore          Float
  classification        String   // "Comprar" | "Revisar" | "Descartar"
  summary               String?
  // null = metodología legado (similitud fotográfica general, 26 subcats
  // con Marcha). "rm-anatomical-2026-08" = metodología nueva (anatomía
  // comparativa por landmarks, 3 vistas x 3 parámetros, sin Marcha) — ver
  // INSTRUCCIONES "NUEVO CABALLO REFERENTE Y SISTEMA DEFINITIVO DE ANÁLISIS
  // IA" (2026-08-13). El cliente (iOS) usa este campo para decidir si el
  // análisis guardado sigue siendo válido para mostrarse como vigente.
  methodologyVersion   String?
  // Clasificación de cada foto del Hip usada en este análisis (vista
  // detectada + validez) — solo aplica a la metodología nueva. null en
  // filas legado. Ver PhotoClassification en src/analysis/prompt.ts.
  photoClassificationsJson Json?

  // MOTOR PROFESIONAL DE ANÁLISIS ANATÓMICO (2026-08-14) — landmarks
  // anatómicos crudos y hallazgos por vista, tal como los calculó el
  // motor (ver src/analysis/anthropicClient.ts, ViewAnalysisDetail).
  // Permite auditar CUALQUIER análisis pasado (qué landmarks se
  // detectaron, con qué confianza, qué desviaciones se midieron) sin
  // volver a llamar a la IA. null en filas de metodologías anteriores.
  landmarksJson Json?
  // Solo los hallazgos priorizados que efectivamente se seleccionaron
  // para mostrar (ver findingsPrioritizer.ts) — subconjunto liviano de
  // landmarksJson pensado para leer rápido sin recorrer todo el detalle.
  findingsJson  Json?

  // Diagnóstico técnico (opcional, para depurar calidad del análisis):
  // cuántos fotogramas de marcha se pudieron usar y de qué duración.
  // LEGADO — la metodología nueva no usa video/marcha en este módulo (ver
  // punto 12 de las instrucciones), así que estos quedan null en filas
  // nuevas. No se eliminan las columnas para no perder el historial viejo.
  gaitFrameCount        Int?
  gaitVideoDurationSec  Float?

  analyzedAt            DateTime @default(now())
  // Modelo usado (para poder re-analizar todo si se cambia de versión).
  model                  String

  @@index([overallScore])
  @@index([hipId, analyzedAt])
  @@index([organizationId, hipId, analyzedAt])
}

// Puntero al análisis VIGENTE de un Hip PARA UNA ORGANIZACIÓN dada — evita
// tener que hacer `ORDER BY version DESC LIMIT 1` en cada lectura del
// ranking/ficha. Reemplaza al viejo `Hip.currentAnalysisId` (que solo podía
// apuntar a UN análisis vigente por Hip en total): bajo multi-tenant, un
// mismo Hip puede tener un análisis vigente distinto por organización.
model CurrentHipAnalysis {
  id             String         @id @default(cuid())
  hipId          String
  hip            Hip            @relation(fields: [hipId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  analysisResultId String
  analysisResult AnalysisResult @relation(fields: [analysisResultId], references: [id], onDelete: Cascade)
  updatedAt      DateTime       @updatedAt

  @@unique([hipId, organizationId])
}

// Decisión final del usuario sobre un Hip ("Comprar"/"Revisar"/"Descartar"
// + notas). Antes vivía SOLO en SwiftData local (por eso no sincronizaba
// entre el iPad y el iPhone) — ahora el servidor es la fuente de verdad;
// el dispositivo queda como caché offline. Resolución de conflictos: el
// más reciente gana (por updatedAt) — alcanza para el patrón de uso real
// (un comprador, normalmente un dispositivo activo a la vez).
model UserDecision {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Denormalizado desde User.organizationId: se podría derivar siempre vía
  // userId → User, pero tenerlo acá también permite filtrar/indexar
  // decisiones por organización directamente (y es una segunda barrera de
  // defensa: un bug que arme mal el `where` de una query no puede filtrar
  // datos de otra organización sin este campo).
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hipId      String
  hip        Hip       @relation(fields: [hipId], references: [id], onDelete: Cascade)
  deviceId   String?
  device     Device?   @relation(fields: [deviceId], references: [id])

  finalCall  String    // "Comprar" | "Revisar" | "Descartar"
  notes      String?
  decidedAt  DateTime  @default(now())

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  // Tombstone en vez de borrado físico: un dispositivo que estaba offline
  // cuando se borró una decisión en otro necesita enterarse del borrado en
  // la próxima sincronización, no solo de altas/cambios.
  deletedAt  DateTime?

  @@unique([userId, hipId])
}

// Anotación a mano alzada sobre el Pedigree de un Hip (lápiz vino tinto +
// borrador, 2026-08-13 — sistema simplificado). Mismo patrón exacto que
// UserDecision: una fila por (userId, hipId), server-as-source-of-truth,
// tombstone (deletedAt) para que un dispositivo offline se entere de un
// borrado. `drawingData` guarda el PKDrawing entero serializado
// (dataRepresentation(), base64) — no vale la pena modelar los trazos como
// filas individuales, la app siempre lee/escribe el dibujo completo de una.
model PedigreeAnnotation {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hipId      String
  hip        Hip       @relation(fields: [hipId], references: [id], onDelete: Cascade)
  deviceId   String?
  device     Device?   @relation(fields: [deviceId], references: [id])

  // Base64 de PKDrawing.dataRepresentation(). Null = sin anotaciones (se
  // guarda igual la fila, o se usa deletedAt, para poder propagar "se
  // borró todo" a otros dispositivos).
  drawingData String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@unique([userId, hipId])
}

// Tira de "Hips recientes" (HipNumberEntryView, 2026-08-31) — mismo patrón
// exacto que UserDecision/PedigreeAnnotation: una fila por (userId, hipId),
// servidor como fuente de verdad, tombstone (deletedAt) para que un
// dispositivo offline se entere de un borrado. A diferencia de esos dos,
// `visitedAt` se pisa en cada visita (no solo se crea una vez) — es lo que
// define el orden "más reciente primero" que ve el usuario, y tiene que
// viajar entre dispositivos para que ese orden sea el mismo en ambos (si
// solo se sincronizara "existe/no existe", dos dispositivos podrían
// mostrar el mismo conjunto de Hips en un orden distinto).
//
// Causa raíz real (2026-08-31, "cuando borro uno y abro otro, vuelven a
// aparecer" + "tampoco estan sincronizados ambos dispositivos"): esta
// función vivía ANTES solo en UserDefaults del dispositivo (ver
// RecentHipsStore, RMSelection/Views/HipNumberEntryView.swift) — cero
// sincronización. Un borrado en un dispositivo nunca llegaba al otro (por
// eso "no sincronizados"), y lo que Ramon interpretó como "vuelven a
// aparecer" era, en el fondo, la misma causa: el otro dispositivo (o el
// mismo, tras un tiempo) seguía mostrando su copia local vieja, nunca
// enterada del borrado. Esta tabla + las rutas /me/recent-hips de abajo
// resuelven ambos síntomas de una sola vez, con el mecanismo ya probado de
// decisiones/anotaciones.
model RecentHipVisit {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hipId      String
  hip        Hip       @relation(fields: [hipId], references: [id], onDelete: Cascade)
  deviceId   String?
  device     Device?   @relation(fields: [deviceId], references: [id])

  visitedAt  DateTime  @default(now())

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@unique([userId, hipId])
}

// Observación de texto libre del usuario sobre un Hip — mismo criterio de
// sincronización que UserDecision (servidor como fuente de verdad,
// tombstone para borrados). Las observaciones generadas por IA siguen
// viviendo en AnalysisResult.summary, no acá — esta tabla es solo para las
// que escribe la persona.
model HipObservation {
  id         String               @id @default(cuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Ver comentario equivalente en UserDecision.organizationId.
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hipId      String
  hip        Hip                  @relation(fields: [hipId], references: [id], onDelete: Cascade)
  deviceId   String?
  device     Device?              @relation(fields: [deviceId], references: [id])

  text       String
  category   ObservationCategory?

  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  deletedAt  DateTime?

  @@index([userId, hipId])
}

// Reporte veterinario cargado por el usuario sobre un Hip (foto del reporte
// en papel + notas) — a pedido (2026-08-08, sincronización multidispositivo)
// para que un reporte cargado en un dispositivo aparezca en todos los demás
// de la misma cuenta. El archivo real vive en almacenamiento de objetos
// (ver MediaAsset/mediaAssetId); este modelo es el registro/metadata.
// Mismo criterio de sync que UserDecision/HipObservation: servidor como
// fuente de verdad, tombstone para borrados.
model VetReport {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Ver comentario equivalente en UserDecision.organizationId.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hipId          String
  hip            Hip          @relation(fields: [hipId], references: [id], onDelete: Cascade)
  deviceId       String?
  device         Device?      @relation(fields: [deviceId], references: [id])

  // La foto/escaneo del reporte, si ya se subió. Opcional porque el
  // registro puede crearse antes de que termine la subida del archivo
  // (ver MediaAsset.uploadStatus).
  mediaAssetId   String?      @unique
  mediaAsset     MediaAsset?  @relation(fields: [mediaAssetId], references: [id])

  notes          String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([userId, hipId])
  @@index([hipId])
}

// Un archivo de medios (foto, video, reporte veterinario, gráfico de
// pedigree) que el usuario capturó o cargó desde cualquier dispositivo —
// a pedido (2026-08-08, sincronización multidispositivo). Antes de esto,
// todos los medios vivían solo como archivos locales en el Documents del
// dispositivo, sin ningún registro compartido; por eso no se veían en
// otros dispositivos de la misma cuenta.
//
// Flujo de subida en dos fases (presigned URL contra almacenamiento de
// objetos tipo S3/R2): el cliente crea este registro con uploadStatus =
// PENDING_UPLOAD y recibe una URL firmada, sube el archivo directamente a
// esa URL, y luego confirma para pasar a PROCESSED. Si la subida falla o
// nunca se confirma, queda en PENDING_UPLOAD/FAILED y no se muestra a
// otros dispositivos como disponible.
model MediaAsset {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Ver comentario equivalente en UserDecision.organizationId.
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hipId          String
  hip            Hip                @relation(fields: [hipId], references: [id], onDelete: Cascade)
  deviceId       String?
  device         Device?            @relation(fields: [deviceId], references: [id])

  kind           MediaKind
  // Clave del objeto en el bucket (no la URL pública firmada, que expira);
  // el backend genera la URL de lectura/escritura firmada a partir de esto
  // cuando se necesita.
  storageKey     String
  // MIME type original, para poder servir/descargar el archivo correctamente.
  contentType    String?
  // Tamaño en bytes, informativo (progreso de subida, límites de cuota).
  byteSize       Int?
  // SOLO para kind == AI_ANALYSIS_PHOTO: "frontal" | "lateral" | "posterior"
  // — la tarjeta que el usuario tocó en el dispositivo de origen para tomar
  // ESTA foto puntual (ver MediaItem.conformationView en iOS). Antes esto
  // vivía SOLO en el SwiftData local de cada dispositivo, nunca viajaba al
  // servidor — así que una foto de Análisis IA sincronizada a otro
  // dispositivo llegaba SIN esta metadata, la tarjeta correspondiente
  // quedaba vacía ahí (no encontraba ninguna foto con esa vista) y el
  // puntaje/hallazgos de esa vista tampoco se mostraban, aunque el archivo
  // ya se hubiera descargado — causa raíz real (2026-08-19) de por qué
  // Análisis IA no se veía entrelazado entre iPad/iPhone. String simple (no
  // un enum de Prisma) porque el backend no necesita validar ni interpretar
  // este valor — es opaco para él, solo lo guarda y lo devuelve tal cual.
  conformationView String?

  uploadStatus   MediaUploadStatus  @default(PENDING_UPLOAD)
  vetReport      VetReport?

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  @@index([userId, hipId])
  @@index([hipId, kind])
}

// El ranking ya armado y ordenado para una venta+jornada — lo que la app
// de iOS lee directamente, sin tener que recalcular nada. Se regenera
// automáticamente 12 horas antes de la sesión y cada vez que un Hip
// afectado se reanaliza.
model RankingSnapshot {
  id             String       @id @default(cuid())
  saleId         String
  sale           Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  // Cada organización arma su propio ranking sobre el mismo catálogo
  // (Sale/Hip global), porque cada una puede tener su propio caballo
  // referente y por lo tanto su propio orden/puntaje.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Día calendario de la jornada que representa este ranking.
  sessionDate    DateTime

  // [{ rank, hipNumber, overallScore, classification }], ya ordenado.
  entriesJson    Json
  totalHipsToday Int

  generatedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, saleId, sessionDate])
}

// Historial de versiones del ranking: una fila nueva CADA VEZ que se
// recalcula (a diferencia de RankingSnapshot, que se sobrescribe y solo
// guarda la versión vigente). Permite mostrar más adelante "cómo cambió el
// top 20 a lo largo del día" — reconstruir esto de forma retroactiva sin
// haberlo capturado no sería posible, así que se guarda desde ahora aunque
// todavía no haya ninguna pantalla que lo muestre.
model RankingSnapshotVersion {
  id             String       @id @default(cuid())
  saleId         String
  sale           Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  sessionDate    DateTime
  entriesJson    Json
  totalHipsToday Int
  // Por qué se disparó esta actualización del ranking: "initial" |
  // "media_changed" | "scheduled_refresh".
  triggerReason  String   @default("initial")

  generatedAt    DateTime @default(now())

  @@index([organizationId, saleId, sessionDate, generatedAt])
}

// Registro de cada ciclo del scheduler — visibilidad operativa mínima
// (Railway rota los logs, esto no). Sirve para poder responder "¿qué pasó
// anoche a las 3am, por qué no se generó el ranking?" sin depender de
// haber tenido los logs abiertos en ese momento.
model SchedulerRun {
  id             String    @id @default(cuid())
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  salesProcessed Int       @default(0)
  analysesRun    Int       @default(0)
  errorMessage   String?

  @@index([startedAt])
}

// Registro de cada corrida del barrido de Media (mediaSweepService.ts) —
// 2026-08-15, a pedido explícito de Ramon tras confirmar que el barrido
// automático (cron "0 3 * * *", ver scheduler.ts) no dejaba ningún estado
// consultable, solo logs de Railway que rotan. Une la corrida automática
// nocturna y cualquier corrida manual de diagnóstico (mismo trigger que
// usa /api/v1/sales/:saleId/media-sweep) bajo el mismo registro — se
// distinguen por `trigger`. `detailsJson` guarda el resumen POR VENTA
// (nombre, Hips revisados, Hips con media nueva, fotos/videos nuevos
// encontrados, Hips todavía sin media publicada) — sirve para responder
// "¿qué pasó anoche a las 3am?" o "¿qué encontró la corrida manual de
// Fasig-Tipton?" sin depender de tener los logs de Railway abiertos en
// ese momento.
model MediaSweepRun {
  id               String    @id @default(cuid())
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  // "scheduled" (cron 3am) | "manual" (POST /sales/:saleId/media-sweep).
  trigger          String
  // "running" | "completed" | "failed".
  status           String    @default("running")
  salesChecked     Int       @default(0)
  salesSkipped     Int       @default(0)
  hipsReviewed     Int       @default(0)
  hipsWithNewMedia Int       @default(0)
  resourcesFound   Int       @default(0)
  errorMessage     String?
  detailsJson      Json?

  @@index([startedAt])
}

// Fotos (y, opcionalmente, video de marcha) del caballo referente del
// Método RM — el patrón oficial contra el que se compara cada Hip. Se
// carga una sola vez desde un panel de administración simple; el backend
// la usa en cada análisis, así que no hace falta configurarla por
// dispositivo como pasaba en la versión on-device.
//
// Scopeada por organización: cada organización puede definir su propio
// patrón referente (por eso AnalysisResult también está scopeado — el
// mismo Hip puede puntuar distinto para cada una).
model ReferenceHorse {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // "default" hoy — un solo patrón activo a la vez por organización. Se
  // deja como string (no un booleano "isActive") por si en el futuro RM
  // Selection quiere patrones distintos por raza/tipo de venta dentro de
  // una misma organización.
  key            String       @default("default")
  // LEGADO (metodología de similitud fotográfica general, hasta 8 fotos
  // sin rol fijo) — se deja sin tocar para no perder el historial, pero el
  // motor de Análisis (IA) nuevo (2026-08-13, "anatomía comparativa") ya NO
  // lee este campo. Ver lateralPhotoUrl/frontalPhotoUrl/posteriorPhotoUrl.
  photoUrls      Json         @default("[]") // string[]
  gaitVideoUrl   String?
  // Nuevo patrón anatómico oficial (2026-08-13): EXACTAMENTE 3 fotos con
  // rol fijo, una por vista — la comparación ya no es "similitud visual
  // general" sino vista-por-vista contra el rol correspondiente (ver
  // src/analysis/prompt.ts). Las 3 son requeridas para poder analizar
  // cualquier vista; si falta alguna, esa vista específica del Hip queda
  // sin poder evaluarse (no se inventa).
  lateralPhotoUrl   String?
  frontalPhotoUrl   String?
  posteriorPhotoUrl String?
  updatedAt      DateTime     @updatedAt

  // Calibración del motor de Análisis Anatómico (2026-08-14, "MOTOR
  // PROFESIONAL DE ANÁLISIS ANATÓMICO RM SELECTION") — landmarks
  // anatómicos ya extraídos de las 3 fotos del referente (pieza C:
  // Reference Horse Calibration), calculados UNA sola vez y reusados en
  // cada análisis de Hip. `calibrationHash` guarda un hash de las 3 URLs
  // de foto; si cambian (se reemplaza el referente), la calibración se
  // recalcula sola la próxima vez que se necesite — ver
  // src/analysis/referenceCalibration.ts.
  calibrationJson Json?
  calibrationHash String?
  calibratedAt    DateTime?

  @@unique([organizationId, key])
}

// Almacenamiento propio (en Postgres, sin depender de R2) para las fotos
// del caballo referente — vía alternativa mientras el bucket de R2 no esté
// configurado (2026-08-10, Tarea 1: sin esto, ReferenceHorse.photoUrls no
// tiene forma de apuntar a ninguna foto real, y sin foto real del
// referente el análisis de IA nunca puede correr). Guarda el archivo
// completo en base64 en una columna de texto — no es lo más eficiente para
// archivos grandes, pero las fotos del referente son pocas (un puñado) y
// se reemplazan poco frecuentemente, así que el costo es aceptable a
// cambio de no depender de ninguna credencial externa. GET
// /api/v1/reference-horse/photos/:id sirve el archivo como imagen real
// (Content-Type correcto) para que analyzeHip pueda hacer fetch() directo,
// igual que con cualquier URL de catálogo.
model ReferenceHorsePhoto {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mimeType       String
  dataBase64     String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// TAREA "Padrillos de primera generación de yearlings 2026" (2026-08-19, a
// pedido de Ramon): identificación visual (verde) en "Buscar padrillo" para
// sementales cuya PRIMERA generación de yearlings se vende en el año
// indicado — NO simplemente "primera vez que aparece en nuestro catálogo".
//
// Entidad NUEVA e independiente de Hip/HipRecord a propósito (auditoría
// previa a implementar, confirmada con Ramon): hoy `sire` es un String
// suelto tanto acá (Hip.sire) como en el modelo de dominio de iOS
// (Pedigree.sire) — no existía ninguna tabla de padrillos. Para que este
// dato sea PERMANENTE y se reconozca en CUALQUIER venta (Keeneland,
// Fasig-Tipton, OBS, cualquier año futuro) sin volver a identificarlo por
// catálogo, tiene que vivir acá, cruzado por nombre — no colgado de una
// venta ni de un Hip puntual.
//
// `name` es la clave de cruce: se normaliza (mayúsculas, sin espacios de
// más) antes de guardar/consultar para no perder coincidencias por
// diferencias de formato entre casas de venta (ver normalizeStallionName
// en stallionService.ts). No hay FK hacia Hip — el cruce lo hace la app
// (iOS) y este mismo backend comparando texto, exactamente igual que ya
// hace el agrupador "Buscar padrillo" de HipNumberEntryView.
//
// `firstYearlingsYear`: año en que esa camada de yearlings sale a la venta
// por primera vez (no el año en que el semental entró a stud, no el año de
// nacimiento de los potrillos). Fuente: prensa especializada del sector
// (TDN, BloodHorse, Fasig-Tipton/Keeneland press releases) que confirma
// "first-crop"/"first yearlings" — nunca inferido ni asumido. `source`
// guarda de dónde salió cada registro, para poder auditar o corregir sin
// tener que volver a investigar desde cero. Lista inicial (2026-08-19,
// ver seed.ts): compilación cruzada entre 3+ fuentes, documentada como NO
// exhaustiva — Keeneland reportó 24 padrillos de primera generación solo
// en su catálogo de September 2026; se cargaron los nombres confirmados
// por nombre propio en cobertura de prensa, quedando lugar para sumar más
// a mano a medida que se identifiquen (sin tocar código, solo una fila
// nueva en esta tabla).
model Stallion {
  id                 String   @id @default(cuid())
  // Normalizado (mayúsculas, trim) — ver normalizeStallionName().
  name               String   @unique
  firstYearlingsYear Int?
  source             String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([firstYearlingsYear])
}

/// CAUSA RAÍZ (2026-08-19, reporte de Ramon: "para la misma foto analizada
/// en 3 oportunidades la IA dio tres resultados diferentes"). El modelo de
/// visión que ubica los landmarks (extractLandmarksFromPhoto,
/// landmarkVisionClient.ts) NO admite el parámetro `temperature` (la API
/// devuelve 400 si se lo mandamos con claude-sonnet-5) — así que cada
/// llamada nueva a IDÉNTICOS bytes de imagen puede devolver coordenadas de
/// landmarks levemente distintas, y esa variación se propaga a las
/// mediciones geométricas (geometry.ts/rmPriorityRules.ts) y de ahí al
/// puntaje final, aunque esa parte del cálculo sí sea 100% determinística.
/// `analyzeHipOnDemand` (rankingService.ts) ya evita esto para el camino
/// OFICIAL (reutiliza el AnalysisResult si el conjunto de 3 fotos no
/// cambió, sin volver a llamar a la IA) — pero eso no cubre todos los
/// caminos reales por los que la MISMA foto puede llegar a pedir landmarks
/// más de una vez (el respaldo local del dispositivo cuando el backend no
/// está disponible, reintentos, recalibración del referente, etc.).
///
/// Esta tabla cierra la puerta de una vez por todas: cachea el resultado
/// de extracción de landmarks por el hash EXACTO de los bytes de la foto
/// (más la vista esperada, que forma parte del prompt) — cualquier
/// llamada futura con esos mismos bytes reutiliza el resultado guardado
/// en vez de volver a preguntarle a la IA, así que la respuesta para una
/// foto puntual, una vez calculada, queda fija para siempre (no solo las
/// primeras 20 veces que se pidió, para SIEMPRE) mientras no cambien las
/// fórmulas de extracción (ver `promptVersion`, mismo criterio que
/// `ENGINE_FORMULA_VERSION` en referenceCalibration.ts).
model LandmarkExtractionCache {
  id            String   @id @default(cuid())
  /// sha256 hex de los bytes JPEG exactos enviados a la IA (después de
  /// downscale/normalización — ver imageDownscale.ts) — no del archivo
  /// original tal como lo subió el dispositivo.
  photoHash     String
  /// Vista que se le indicó al modelo (frontal/lateral/posterior) o "" si
  /// no se indicó ninguna (foto de Hip, sin pista). Se incluye en la clave
  /// porque cambia el texto exacto del prompt.
  expectedView  String   @default("")
  /// Versión del prompt de extracción — si el prompt cambia de forma que
  /// podría alterar el resultado, subir este valor invalida el caché
  /// automáticamente (mismo criterio que ENGINE_FORMULA_VERSION).
  promptVersion String
  /// ParsedLandmarkExtraction completo (view/valid/invalidReason/
  /// overallConfidence/landmarks), tal como lo devuelve extractLandmarksFromPhoto.
  landmarksJson Json
  createdAt     DateTime @default(now())

  @@unique([photoHash, expectedView, promptVersion])
}
