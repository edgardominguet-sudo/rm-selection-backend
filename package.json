{
  "name": "rm-selection-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend de RM Selection: descarga catálogos, corre el análisis del Método RM con IA y genera el Ranking del Día automáticamente, 12 horas antes de cada jornada de venta, para Fasig-Tipton, Keeneland y (a futuro) OBS.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "prisma migrate deploy && npm run db:seed && node dist/index.js",
    "dev": "prisma generate && ts-node-dev --respawn --transpile-only src/index.ts",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "db:seed": "ts-node prisma/seed.ts",
    "studio": "prisma studio"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@prisma/client": "^5.20.0",
    "@sparticuz/chromium": "^131.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "node-cron": "^3.0.3",
    "pdf-parse": "^1.1.1",
    "puppeteer-core": "^23.11.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.4",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
